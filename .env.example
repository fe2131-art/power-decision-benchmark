# OpenAI Responses / Decisions API. Never commit real key values.
OPENAI_API_KEY=

# The program does NOT automatically read .env files.
# Export the variable in your shell before running benchmark.py.
# Linux / macOS: export OPENAI_API_KEY="..."
# PowerShell: $env:OPENAI_API_KEY="..."

# Default local endpoints (pass via CLI: --clef-url and --d1-url)
CLEF_URL=http://127.0.0.1:30000
D1_URL=http://127.0.0.1:8080
